<UserControl x:Class="KevGitChanges.ToolWindow1Control"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:local="clr-namespace:KevGitChanges"
             xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
             Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"
             Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300"
             Name="MyToolWindow">
    <Grid>
        <Grid.Resources>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <local:TreeViewIndentToMarginConverter x:Key="TreeIndentToMargin" />
            <SolidColorBrush x:Key="ScopeWBrush" Color="#0EA5E9" />
            <SolidColorBrush x:Key="ScopeLBrush" Color="#8B5CF6" />
            <SolidColorBrush x:Key="ScopeRBrush" Color="#F97316" />
            <SolidColorBrush x:Key="ScopeMBrush" Color="#14B8A6" />
            <Color x:Key="FolderBiasColor">#E6C24A</Color>
            <!-- Use Visual Studio themed brushes for tree views -->
            <Style TargetType="TreeView">
                <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <!-- Stronger ComboBox template to prevent OS bright hover - use themed background and control template triggers -->
            <Style x:Key="ThemedComboBoxTemplate" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="0">
                                <Grid>
                                    <ToggleButton x:Name="ToggleButton" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  Background="Transparent" BorderBrush="Transparent" Focusable="False" Padding="6,0,6,0">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Opacity" Value="0.6" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="22" />
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter Grid.Column="0" Margin="6,0,6,0" VerticalAlignment="Center"
                                                              Content="{TemplateBinding SelectionBoxItem}"
                                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                                            <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,6,0"
                                                  Data="M 0 0 L 4 4 L 8 0 Z"
                                                  Fill="{TemplateBinding Foreground}" />
                                        </Grid>
                                    </ToggleButton>
                                    <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                            <ScrollViewer CanContentScroll="True">
                                                <ItemsPresenter />
                                            </ScrollViewer>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.6" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="TreeViewItem">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TreeViewItem">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border x:Name="Bd" Grid.ColumnSpan="2" Background="{TemplateBinding Background}">
                                    <Grid Margin="{Binding Depth, Converter={StaticResource TreeIndentToMargin}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ToggleButton x:Name="Expander" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                                      ClickMode="Press" Focusable="False" Width="16" Height="16" Margin="0,0,4,0"
                                                      Background="Transparent" BorderThickness="0"
                                                      Visibility="{Binding HasItems, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibility}}">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="Transparent" BorderThickness="0">
                                                        <ContentPresenter
                                                            ContentSource="Content"
                                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                    </Border>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                            <Path x:Name="ExpanderPath" Data="M 0 0 L 4 4 L 8 0" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                                <Path.RenderTransform>
                                                    <RotateTransform Angle="-90" CenterX="4" CenterY="2" />
                                                </Path.RenderTransform>
                                            </Path>
                                        </ToggleButton>
                                        <ContentPresenter x:Name="PART_Header" Grid.Column="1" ContentSource="Header" HorizontalAlignment="Stretch" />
                                    </Grid>
                                </Border>

                                <ContentPresenter Grid.Column="1" ContentTemplate="{DynamicResource StatusColumnsTemplate}" Content="{Binding}" HorizontalAlignment="Right" />
                                <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.ColumnSpan="2" Visibility="Collapsed" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="HasItems" Value="True">
                                    <Setter TargetName="Expander" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsExpanded" Value="True">
                                    <Setter TargetName="ExpanderPath" Property="RenderTransform">
                                        <Setter.Value>
                                            <RotateTransform Angle="0" CenterX="4" CenterY="2" />
                                        </Setter.Value>
                                    </Setter>
                                    <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}" />
                                    <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsSelected" Value="True" />
                                        <Condition Property="IsSelectionActive" Value="False" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}" />
                                    <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Themed ComboBox and Button with disabled visuals -->
            <Style TargetType="ComboBox">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
                <Setter Property="Padding" Value="4,2" />
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.6" />
                        <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="Button">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
                <Setter Property="Padding" Value="4,2" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.6" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.6" />
                        <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="ComboBoxItem">
                <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
            </Style>

            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
            </Style>

            <Style x:Key="ScopeCellStyle" TargetType="StackPanel">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="">
                        <Setter Property="Visibility" Value="Hidden" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Hidden" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="PillBox" TargetType="Border">
                <Setter Property="CornerRadius" Value="2" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,0,0" />
                <Setter Property="Width" Value="18" />
                <Setter Property="Height" Value="16" />
            </Style>

            <DataTemplate x:Key="StatusColumnsTemplate">
                <Grid HorizontalAlignment="Right" Width="220">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right" Style="{StaticResource ScopeCellStyle}" Tag="{Binding WStatus}" ToolTip="{Binding WToolTip}">
                        <Border Background="{StaticResource ScopeWBrush}" Style="{StaticResource PillBox}">
                            <TextBlock Text="W" Foreground="White" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                        </Border>
                        <Border Background="{Binding WBrush}" Style="{StaticResource PillBox}">
                            <TextBlock Text="{Binding WStatus}" Foreground="White" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Style="{StaticResource ScopeCellStyle}" Tag="{Binding LStatus}" ToolTip="{Binding LToolTip}">
                        <Border Background="{StaticResource ScopeLBrush}" Style="{StaticResource PillBox}">
                            <TextBlock Text="L" Foreground="White" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                        </Border>
                        <Border Background="{Binding LBrush}" Style="{StaticResource PillBox}">
                            <TextBlock Text="{Binding LStatus}" Foreground="White" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Style="{StaticResource ScopeCellStyle}" Tag="{Binding RStatus}" ToolTip="{Binding RToolTip}">
                        <Border Background="{StaticResource ScopeRBrush}" Style="{StaticResource PillBox}">
                            <TextBlock Text="R" Foreground="White" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                        </Border>
                        <Border Background="{Binding RBrush}" Style="{StaticResource PillBox}">
                            <TextBlock Text="{Binding RStatus}" Foreground="White" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" Style="{StaticResource ScopeCellStyle}" Tag="{Binding MStatus}" ToolTip="{Binding MToolTip}">
                        <Border Background="{StaticResource ScopeMBrush}" Style="{StaticResource PillBox}">
                            <TextBlock Text="B" Foreground="White" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                        </Border>
                        <Border Background="{Binding MBrush}" Style="{StaticResource PillBox}">
                            <TextBlock Text="{Binding MStatus}" Foreground="White" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <Style TargetType="ContextMenu">
                <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HasDropShadow" Value="False" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContextMenu">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="0">
                                <ItemsPresenter Margin="0" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="MenuItem">
                <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0" Padding="8,4">
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.6" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="Separator">
                <Setter Property="Margin" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Separator">
                            <Grid Height="1" Background="Transparent">
                                <Border Height="1" Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}" HorizontalAlignment="Stretch" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="6" Grid.Row="0">
            <TextBlock Margin="6" VerticalAlignment="Center">Base branch</TextBlock>
            <ComboBox Name="BaseBranchCombo" Margin="6" SelectionChanged="BaseBranchCombo_SelectionChanged"
                      Style="{StaticResource ThemedComboBoxTemplate}"
                      Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
                      Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
                      BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}">
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}" />
                        <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
                    </Style>
                </ComboBox.ItemContainerStyle>
            </ComboBox>
            <Button Content="Fetch" Click="Fetch_Click" Padding="5" Margin="6" Name="fetchButton"
                    Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
                    Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
                    BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
            <Button Content="Refresh" Click="Refresh_Click" Padding="5" Margin="6" Name="refreshButton"
                    Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
                    Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
                    BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
            <TextBlock Margin="6" VerticalAlignment="Center">Branch</TextBlock>
            <ComboBox Name="CheckoutBranchCombo" Margin="6" SelectionChanged="CheckoutBranchCombo_SelectionChanged"
                      Style="{StaticResource ThemedComboBoxTemplate}"
                      Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
                      Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
                      BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
            <ProgressBar Name="BusyIndicator" Width="80" Margin="6" Visibility="Collapsed" IsIndeterminate="True" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="6" Grid.Row="1">
            <TextBlock Margin="6,6,4,6" VerticalAlignment="Center">Compare</TextBlock>
            <ComboBox Name="CompareFromCombo" Width="110" Margin="4,6" SelectionChanged="CompareSelection_Changed"
                      Style="{StaticResource ThemedComboBoxTemplate}"
                      Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
                      Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
                      BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
            <TextBlock Margin="4,6" VerticalAlignment="Center">vs</TextBlock>
            <ComboBox Name="CompareToCombo" Width="110" Margin="4,6" SelectionChanged="CompareSelection_Changed"
                      Style="{StaticResource ThemedComboBoxTemplate}"
                      Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
                      Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
                      BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="6" Grid.Row="2">
            <TextBlock Margin="6,6,4,6" VerticalAlignment="Center">Show</TextBlock>
            <CheckBox Name="ShowWorkspace" Margin="6,6,0,6" Content="Workspace" IsChecked="True" Checked="FilterChanged" Unchecked="FilterChanged" />
            <CheckBox Name="ShowLocal" Margin="10,6,0,6" Content="Local" IsChecked="True" Checked="FilterChanged" Unchecked="FilterChanged" />
            <CheckBox Name="ShowRemote" Margin="10,6,0,6" Content="Remote" IsChecked="True" Checked="FilterChanged" Unchecked="FilterChanged" />
            <CheckBox Name="ShowMain" Margin="10,6,0,6" Content="Base" IsChecked="True" Checked="FilterChanged" Unchecked="FilterChanged" />
        </StackPanel>

        <Grid Grid.Row="3" Margin="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- Local changes List -->
            <Grid Grid.Column="0" Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Grid.Row="0">
                    <TextBlock FontWeight="Bold" VerticalAlignment="Center">Changes</TextBlock>
                    <TextBlock Name="LocalCount" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="Gray">(0)</TextBlock>
                </StackPanel>
                <TreeView Name="LocalTree" Grid.Row="1" Margin="0,6,0,0" PreviewMouseRightButtonDown="TreeView_PreviewMouseRightButtonDown"
                          Grid.IsSharedSizeScope="True"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.CanContentScroll="True"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <imaging:CrispImage Width="20" Height="16" Margin="0,0,4,0" Moniker="{Binding IconMoniker}">
                                    <imaging:CrispImage.Style>
                                        <Style TargetType="imaging:CrispImage">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFile}" Value="False">
                                                    <Setter Property="imaging:CrispImage.GrayscaleBiasColor" Value="{StaticResource FolderBiasColor}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </imaging:CrispImage.Style>
                                </imaging:CrispImage>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                    <TreeView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Open file" Click="OpenFile_Click" />
                            <Separator />
                            <MenuItem Name="CompareWithLocalMenu" Header="Compare vs Local" Click="CompareWithLocal_Click" />
                            <MenuItem Name="CompareWithRemoteMenu" Header="Compare vs Remote" Click="CompareWithRemote_Click" />
                            <MenuItem Name="CompareWithMainMenu" Header="Compare vs Base" Click="CompareWithMain_Click" />
                            <Separator />
                            <MenuItem Name="CompareSelectionMenu" Header="Compare selection (A vs B)" Click="CompareSelected_Click" />
                        </ContextMenu>
                    </TreeView.ContextMenu>
                </TreeView>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
